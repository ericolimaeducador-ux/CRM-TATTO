# Copie para .env somente no caminho sem Docker.
# O arquivo .env não entra no Git. Nenhum valor abaixo é segredo real.
# `docker compose up` sobe em produção local sem este arquivo: no primeiro
# boot a API grava chave e pepper no volume `segredos` e não imprime os valores.
# Pepper vazio, placeholder ou com menos de 32 caracteres é recusado.

NODE_ENV=production
PORT=3000
MONGO_URI=mongodb://localhost:27017/captura7
CIFRA_CHAVE_BASE64=preencha-com-32-bytes-em-base64
# Placeholder é recusado. Gere pelo menos 32 caracteres fora do repositório.
CIFRA_PEPPER=preencha-com-pepper-aleatorio
# Não há emissor de JWT. JWT_SEGREDO saiu porque nenhum código lia essa variável.
# Vazio no Compose local: o site chama /v1 no mesmo endereço e o nginx encaminha.
# Para um site publicado em outro domínio, use a URL da API sem barra no fim,
# por exemplo https://api.exemplo.com. Não há workflow de publicação no repositório.
VITE_API_URL=

# Cabeçalhos x-papel-teste, x-usuario-id, x-autor-nome e x-step-up-teste
# só valem com NODE_ENV=test ou com CAPTURA7_HEADERS_TESTE=1 na API.
# Em production continuam ignorados, mesmo com a flag.
# O front só os envia com MODE=test ou VITE_CAPTURA7_HEADERS_TESTE=1 no build.
# O Compose de development não liga nenhuma das duas. O e2e liga as duas.
# CAPTURA7_HEADERS_TESTE=1
# VITE_CAPTURA7_HEADERS_TESTE=1

# Google Sheets API v4, somente leitura. Sem estes três valores a ingestão
# fica desligada e a captura manual continua. Não cole token real aqui.
# O dono fornece: id da planilha de respostas do Forms, token OAuth com
# escopo spreadsheets.readonly (chave de API não lê planilha privada) e o
# ObjectId de quem responde pela ingestão.
SHEETS_PLANILHA_ID=preencha-com-id-da-planilha
SHEETS_TOKEN=preencha-com-token-oauth-somente-leitura
SHEETS_RESPONSAVEL_ID=preencha-com-objectid-do-responsavel
SHEETS_ABA=Respostas

# Saída genérica quando um contato vira cliente. O dono não nomeou um ERP:
# esta URL recebe POST /v1/integracao/contatos-promovidos com corpo JSON.
# Cabeçalhos: X-Captura7-Assinatura (HMAC-SHA256 hex do corpo cru),
# X-Captura7-Timestamp (ms) e X-Captura7-Idempotencia (contatoId:versao).
# Sem URL e segredo reais, a promoção segue e a entrega fica nao_configurado,
# sem mensagem de erro. Deixe vazio para manter desligado.
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SEGREDO=

# Backup 3-2-1. A chave cifra o arquivo antes de qualquer cópia.
# BACKUP_REMOTO_DESTINO fica vazio até existir bucket do dono (s3:// ou b2://).
BACKUP_DIR=
BACKUP_CHAVE=preencha-com-32-bytes-em-base64
BACKUP_REMOTO_DESTINO=

# Prazo de guarda da trilha de auditoria, em dias. Sem valor, a rotina não apaga linha.
# Não há número padrão: depende da D9. Mesmo preenchido, a trilha não é apagada.
# AUDITORIA_PRAZO_GUARDA_DIAS=

# QR de autocadastro. Sem estas variáveis: 7200 segundos (2 h) e 1 uso.
# O uso só é gasto quando o cadastro é gravado. Revogação em POST /v1/qr/:token/revogar.
# QR_TOKEN_TTL_SEGUNDOS=7200
# QR_TOKEN_MAX_USOS=1

# Saltos de proxy confiáveis à frente da API. 1 = só o nginx do Compose.
# Ausente, a API não confia em X-Forwarded-For. true não é aceito.
# CAPTURA7_TRUST_PROXY_SALTOS=1

# Controlador pessoa física. O termo mostra este e-mail. Sem valor, a tela diz
# "defina CONTROLADOR_EMAIL". Não cole senha aqui.
CONTROLADOR_EMAIL=
# Meses sem interação até o expurgo do cadastro. Fora de 1 a 120, vale 24.
RETENCAO_MESES=24
# Dias após a revogação para eliminar o cadastro, e após a eliminação para
# apagar o documento. A trilha de auditoria permanece. Fora de 1 a 3650, vale 30.
PURGA_REVOGACAO_DIAS=30
# Dias sem alteração para eliminar um rascunho. Fora de 1 a 3650, vale 180.
RASCUNHO_DIAS=180
# Origens extras do navegador, separadas por vírgula, além de localhost e da rede local.
# Exemplo futuro, sem publicar nada agora: https://usuario.github.io
CORS_ORIGENS=

# Captcha do autocadastro público. local funciona sem conta externa.
# hcaptcha e turnstile exigem o segredo correspondente; sem ele o cadastro para.
CAPTCHA_PROVEDOR=local
HCAPTCHA_SEGREDO=
TURNSTILE_SEGREDO=

# Primeiro administrador: pnpm criar-admin. A senha não fica neste arquivo.
# ADMIN_LOGIN=
# ADMIN_SENHA=
# ADMIN_NOME=Erico Henrique de Lima Araujo
