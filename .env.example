# Copie para .env somente se quiser fixar segredo na sua máquina.
# O arquivo .env não entra no Git. Nenhum valor abaixo é segredo real.
# `docker compose up` sobe sem este arquivo: em development a API gera
# chave e pepper efêmeros no boot e avisa no log. Produção recusa subir sem eles.

NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/captura7
CIFRA_CHAVE_BASE64=preencha-com-32-bytes-em-base64
CIFRA_PEPPER=preencha-com-pepper-aleatorio
JWT_SEGREDO=preencha-com-segredo-de-sessao
VITE_API_URL=http://localhost:3000

# Google Sheets API v4, somente leitura. Sem estes três valores a ingestão
# fica desligada e a captura manual continua. Não cole token real aqui.
# O dono fornece: id da planilha de respostas do Forms, token OAuth com
# escopo spreadsheets.readonly (chave de API não lê planilha privada) e o
# ObjectId de quem responde pela ingestão.
SHEETS_PLANILHA_ID=preencha-com-id-da-planilha
SHEETS_TOKEN=preencha-com-token-oauth-somente-leitura
SHEETS_RESPONSAVEL_ID=preencha-com-objectid-do-responsavel
SHEETS_ABA=Respostas

# Saída genérica quando um contato vira cliente. O dono não nomeou um ERP:
# esta URL recebe POST /v1/integracao/contatos-promovidos com corpo JSON.
# Cabeçalhos: X-Captura7-Assinatura (HMAC-SHA256 hex do corpo cru),
# X-Captura7-Timestamp (ms) e X-Captura7-Idempotencia (contatoId:versao).
# Sem URL e segredo reais, a promoção segue e a entrega fica nao_configurado.
ERP_WEBHOOK_URL=preencha-com-url-do-webhook
ERP_WEBHOOK_SEGREDO=preencha-com-segredo-hmac

# Backup 3-2-1. A chave cifra o arquivo antes de qualquer cópia.
# BACKUP_REMOTO_DESTINO fica vazio até existir bucket do dono (s3:// ou b2://).
BACKUP_DIR=
BACKUP_CHAVE=preencha-com-32-bytes-em-base64
BACKUP_REMOTO_DESTINO=

# Prazo de guarda da trilha de auditoria, em dias. Sem valor, a rotina não apaga linha.
# Não há número padrão: depende da D9. Mesmo preenchido, a trilha não é apagada.
# AUDITORIA_PRAZO_GUARDA_DIAS=
